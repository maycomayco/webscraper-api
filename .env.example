# YouTube Music authentication
# Required for playlist creation. Two methods supported:
#
# 1. OAuth2 (RECOMMENDED) — auto-refreshing, no manual cookie copying
#    Steps:
#    a. Create Google Cloud project, enable YouTube Data API v3
#    b. Create OAuth2 credentials for "TV and Limited Input devices"
#    c. Set YOUTUBE_CLIENT_ID and YOUTUBE_CLIENT_SECRET below
#    d. Run: node scripts/youtube-auth.js
#    e. Follow printed instructions (visit URL, enter code)
#    f. Tokens saved to data/youtube-oauth-tokens.json
#    g. Copy file contents to YOUTUBE_OAUTH_TOKENS_JSON env var (Render)
#
# 2. Cookie auth (LEGACY) — manual, expires every few weeks
#    Copy Cookie header from DevTools on music.youtube.com
#    YOUTUBE_MUSIC_COOKIES=SAPISID=...; __Secure-1PSID=...; ...

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Fallback: paste the full JSON from data/youtube-oauth-tokens.json here
# Useful when Render filesystem resets after deploy.
YOUTUBE_OAUTH_TOKENS_JSON=

# Legacy cookie auth (only used if OAuth2 is not configured)
YOUTUBE_MUSIC_COOKIES=
